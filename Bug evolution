-- =================================================================
-- DYNAMIC REMOTE DISCOVERY (Scans actual game remotes automatically)
-- =================================================================
local Remotes = {}
local remoteNamesList = {}

local function scanRemotes()
    local parentSearch = RemotesFolder or ReplicatedStorage
    for _, desc in ipairs(parentSearch:GetDescendants()) do
        if desc:IsA("RemoteEvent") or desc:IsA("UnreliableRemoteEvent") then
            Remotes[desc.Name] = desc
            if not table.find(remoteNamesList, desc.Name) then
                table.insert(remoteNamesList, desc.Name)
            end
        end
    end
end
scanRemotes()

local function fireRemoteZeroCD(remoteName, ...)
    local remote = Remotes[remoteName]
    if remote then
        pcall(function()
            remote:FireServer(...)
        end)
    else
        -- Fallback search if called dynamically
        local found = ReplicatedStorage:FindFirstChild(remoteName, true)
        if found and found:IsA("RemoteEvent") then
            found:FireServer(...)
        end
    end
end

