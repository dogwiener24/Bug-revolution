-- 3. AUTOMATIC MAPPING OF ALL REMOTES (`ReplicatedStorage.Remotes`)
-- =================================================================
local Remotes = {}
local function cacheRemotes()
    if RemotesFolder then
        for _, desc in ipairs(RemotesFolder:GetDescendants()) do
            if desc:IsA("RemoteEvent") or desc:IsA("UnreliableRemoteEvent") then
                Remotes[desc.Name] = desc
            end
        end
    end
    for _, desc in ipairs(game:GetDescendants()) do
        if desc:IsA("RemoteEvent") and not Remotes[desc.Name] then
            Remotes[desc.Name] = desc
        end
    end
end
cacheRemotes()

local function fireRemoteZeroCD(remoteName, ...)
    local remote = Remotes[remoteName]
    if remote then
        pcall(function()
            remote:FireServer(...)
        end)
    end
end

