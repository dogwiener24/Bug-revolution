local CachedAttackRemotes = {}
local function checkAndCache(descendant)
    if descendant:IsA("RemoteEvent") and (descendant.Name == "HitConfirm" or descendant.Name == "Attack") then
        if not table.find(CachedAttackRemotes, descendant) then
            table.insert(CachedAttackRemotes, descendant)
        end
    end
end

for _, desc in ipairs(game:GetDescendants()) do checkAndCache(desc) end
game.DescendantAdded:Connect(checkAndCache)

-- Anti-Cheat Memory Bypass Hook (`getgc`, `getupvalues`, `getconstants`)
pcall(function()
    for _, obj in ipairs(getgc(true)) do
        if type(obj) == "function" then
            local i = 1
            while true do
                local name, val = debug.getupvalue(obj, i)
                if not name then break end
                if type(val) == "number" and val > 0 and val < 5 then
                    pcall(debug.setupvalue, obj, i, 0)
                elseif type(val) == "table" then
                    rawset(val, "Cooldown", 0)
                    rawset(val, "Debounce", false)
                    rawset(val, "AttackCooldown", 0)
                end
                i = i + 1
            end
            local successConst, constants = pcall(getconstants, obj)
            if successConst and constants then
                for idx, const in ipairs(constants) do
                    if type(const) == "number" and const > 0.1 and const < 5 then
                        pcall(setconstant, obj, idx, 0)
                    end
                end
            end
        elseif type(obj) == "table" then
            rawset(obj, "Cooldown", 0)
            rawset(obj, "Debounce", false)
            rawset(obj, "AttackCooldown", 0)
        end
    end
end)

-- Velocity Speed Bypass Loop
RunService.Heartbeat:Connect(function(dt)
    if Config.SpeedBypass and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.MoveDirection.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(
                hum.MoveDirection.X * Config.CustomSpeed,
                hrp.AssemblyLinearVelocity.Y,
                hum.MoveDirection.Z * Config.CustomSpeed
            )
        end
    end
end)

-- 10x Attack Loop
task.spawn(function()
    while true do
        task.wait(0.15)
        if Config.SafeAttackActive and #CachedAttackRemotes > 0 then
            for _, remote in ipairs(CachedAttackRemotes) do
                pcall(function()
                    if remote and remote.Parent then
                        for i = 1, (Config.AttackMultiplier or 10) do
                            remote:FireServer({
                                Time = tick() + (i * 0.001),
                                Timestamp = os.time(),
                                Index = i,
                                Reach = (Config.BaseReach or 4.4) * Config.ReachMultiplier
                            })
                            task.wait(0.02)
                        end
                    end
                end)
            end
        end
    end
end)

-- Auto Tool Burst Loop
task.spawn(function()
    while true do
        if Config.AutoToolActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local tool = char:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                    if tool then
                        if tool.Parent ~= char then tool.Parent = char end
                        tool:Activate()
                        VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                        task.wait(0.05)
                        VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                    end
                end
            end)
        end
        task.wait(0.2)
    end
end)

