-- Full Signal Class Mirror[span_10](start_span)[span_10](end_span)
local defaultSignalFile = [[
    local Signal = {}
    Signal.__index = Signal

    function Signal.new()
        return setmetatable({ ["_handlers"] = {} }, Signal)
    end

    function Signal:Connect(handler)
        table.insert(self._handlers, handler)
        local handlersRef = self._handlers
        return {
            ["Disconnect"] = function()
                local idx = table.find(handlersRef, handler)
                if idx then table.remove(handlersRef, idx) end
            end
        }
    end

    function Signal:Fire(...)
        for _, handler in ipairs(table.clone(self._handlers)) do
            task.spawn(handler, ...)
        end
    end

    return Signal
]]

